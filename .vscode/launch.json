    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "program": "${file}",
            "console": "integratedTerminal"
        },
        
        {
            "name": "create_dataset",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "program": "${workspaceFolder}/main.py",
            "args": ["--create-dataset"],
            "console": "integratedTerminal"
        },
        
        {
            "name": "preprocess_dataset",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "program": "${workspaceFolder}/main.py",
            "args": ["--preprocess-dataset"],
            "console": "integratedTerminal"
        },

        {
            "name": "evaluate",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "program": "${workspaceFolder}/main.py",
            "args": ["--evaluate"],
            "console": "integratedTerminal"
        },

        {
            "name": "fit",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "program": "${workspaceFolder}/main.py",
            "args": ["--fit"],
            "console": "integratedTerminal"
        },

        {
            "name": "predict",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/main.py",
            "args": ["--predict"],
            "console": "integratedTerminal"
        }
    ]
}